.header-banner {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  padding: 48rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 0 0 40rpx 40rpx;
}

.banner-content {
  flex: 1;
}

.ai-badge {
  display: inline-block;
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.badge-text {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 600;
}

.banner-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.banner-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.banner-decoration {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.deco-emoji {
  font-size: 64rpx;
}

.history-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
}

.history-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.history-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.evaluate-types {
  padding: 40rpx 32rpx 24rpx;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 24rpx;
}

.type-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.type-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 4rpx solid transparent;
  transition: all 0.3s;
}

.type-item.active {
  border-color: #4a90e2;
  background: linear-gradient(135deg, rgba(74, 144, 226, 0.05) 0%, rgba(53, 122, 189, 0.05) 100%);
}

.type-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.type-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.type-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

.input-section {
  padding: 24rpx 32rpx;
}

.input-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 32rpx;
}

.project-input {
  width: 100%;
  min-height: 300rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #333333;
}

.placeholder {
  color: #cccccc;
  font-size: 28rpx;
}

.input-footer {
  display: flex;
  justify-content: flex-end;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.char-count {
  font-size: 24rpx;
  color: #999999;
}

.upload-section {
  margin-top: 24rpx;
}

.upload-title {
  display: block;
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.upload-btns {
  display: flex;
  gap: 24rpx;
}

.upload-btn {
  flex: 1;
  background: #ffffff;
  border: 2rpx dashed #dddddd;
  border-radius: 16rpx;
  padding: 32rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.upload-icon {
  display: block;
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.upload-text {
  display: block;
  font-size: 26rpx;
  color: #666666;
}

.upload-list {
  margin-top: 24rpx;
}

.upload-item {
  display: flex;
  align-items: center;
  background: #f9f9f9;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.upload-item-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.upload-item-name {
  flex: 1;
  font-size: 26rpx;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.upload-item-remove {
  font-size: 36rpx;
  color: #ff4d4f;
  padding: 0 16rpx;
}

.submit-section {
  padding: 32rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  border-radius: 50rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, 0.4);
  border: none;
}

.submit-btn[disabled] {
  background: #cccccc;
  box-shadow: none;
}

.btn-content, .loading-content {
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 16rpx;
}

.loading-text {
  font-size: 32rpx;
  color: #ffffff;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.result-section {
  padding: 32rpx;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.result-time {
  font-size: 24rpx;
  color: #999999;
}

.score-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 24rpx;
}

.score-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.score-circle {
  width: 180rpx;
  height: 180rpx;
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.score-ring {
  width: 150rpx;
  height: 150rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #4a90e2;
}

.score-label {
  font-size: 22rpx;
  color: #999999;
}

.score-grade {
  font-size: 72rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.score-bars {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.score-bar-item {
  display: flex;
  flex-direction: column;
}

.bar-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.bar-label {
  font-size: 26rpx;
  color: #666666;
}

.bar-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
}

.bar-track {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 1s ease;
}

.analysis-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.analysis-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 20rpx;
}

.analysis-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.analysis-item {
  display: flex;
  align-items: flex-start;
}

.item-bullet {
  font-size: 28rpx;
  margin-right: 16rpx;
  color: #48b879;
}

.analysis-item.risk .item-bullet {
  color: #ff4d4f;
}

.item-text {
  flex: 1;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}

.suggestion-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.suggestion-item {
  display: flex;
  align-items: flex-start;
}

.suggestion-num {
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  border-radius: 50%;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.suggestion-text {
  flex: 1;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}

.action-btns {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50rpx;
  padding: 24rpx;
  font-size: 28rpx;
  border: none;
}

.action-btn text {
  margin-right: 8rpx;
}

.action-btn.secondary {
  background: #f5f5f5;
  color: #666666;
}

.action-btn.primary {
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  color: #ffffff;
}

.report-header {
  margin-bottom: 32rpx;
}

.report-meta {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  background: rgba(74, 144, 226, 0.1);
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
}

.meta-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #4a90e2;
}

.score-circle {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 12rpx 40rpx rgba(74, 144, 226, 0.3);
}

.score-ring {
  width: 160rpx;
  height: 160rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.score-progress {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: conic-gradient(#48b879 var(--progress), transparent var(--progress));
  opacity: 0;
}

.score-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #4a90e2;
}

.score-label {
  font-size: 24rpx;
  color: #999999;
}

.score-grade-wrap {
  flex: 1;
  display: flex;
  justify-content: center;
}

.score-grade {
  padding: 24rpx 48rpx;
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.grade-text {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  color: #ffffff;
}

.grade-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 8rpx;
}

.score-summary {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f0f0f0;
}

.summary-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}

.summary-text .highlight {
  color: #4a90e2;
  font-weight: 600;
}

.dimension-summary {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.dim-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 100rpx;
}

.dim-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-bottom: 8rpx;
}

.dim-name {
  font-size: 22rpx;
  color: #666666;
  margin-bottom: 4rpx;
}

.dim-score {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.radar-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.radar-chart {
  width: 100%;
  height: 340rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radar-grid {
  width: 280rpx;
  height: 280rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radar-ring-outer {
  position: absolute;
  width: 100%;
  height: 100%;
  border: 2rpx solid #e8e8e8;
  border-radius: 50%;
}

.radar-ring-middle {
  position: absolute;
  width: 70%;
  height: 70%;
  border: 2rpx solid #e8e8e8;
  border-radius: 50%;
}

.radar-ring-inner {
  position: absolute;
  width: 40%;
  height: 40%;
  border: 2rpx solid #e8e8e8;
  border-radius: 50%;
}

.radar-nodes {
  position: absolute;
  width: 280rpx;
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radar-node {
  position: absolute;
  border-radius: 50%;
  opacity: 0.7;
  transform: translate(-50%, -50%);
}

.radar-node.node-1 {
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  top: 15%;
  left: 50%;
}

.radar-node.node-2 {
  background: linear-gradient(135deg, #48b879 0%, #38a06a 100%);
  top: 38%;
  left: 88%;
}

.radar-node.node-3 {
  background: linear-gradient(135deg, #ff9900 0%, #e68a00 100%);
  top: 85%;
  left: 68%;
}

.radar-node.node-4 {
  background: linear-gradient(135deg, #00bcd4 0%, #00a0b0 100%);
  top: 85%;
  left: 32%;
}

.radar-node.node-5 {
  background: linear-gradient(135deg, #9c27b0 0%, #89209e 100%);
  top: 38%;
  left: 12%;
}

.radar-labels {
  position: absolute;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.radar-label {
  position: absolute;
  font-size: 22rpx;
  color: #666666;
  font-weight: 500;
}

.radar-label.label-top {
  top: 8%;
  left: 50%;
  transform: translateX(-50%);
}

.radar-label.label-right {
  top: 38%;
  right: 5%;
}

.radar-label.label-bottom-right {
  bottom: 8%;
  right: 15%;
}

.radar-label.label-bottom-left {
  bottom: 8%;
  left: 15%;
}

.radar-label.label-left {
  top: 38%;
  left: 5%;
}

.radar-legend {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f0f0f0;
}

.legend-item {
  display: flex;
  align-items: center;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.legend-text {
  font-size: 24rpx;
  color: #666666;
}

.detail-section {
  margin-bottom: 24rpx;
}

.indicator-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.indicator-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.indicator-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
}

.indicator-icon.bg-blue {
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
}

.indicator-icon.bg-green {
  background: linear-gradient(135deg, #48b879 0%, #38a06a 100%);
}

.indicator-icon.bg-orange {
  background: linear-gradient(135deg, #ff9900 0%, #e68a00 100%);
}

.indicator-icon.bg-purple {
  background: linear-gradient(135deg, #9c27b0 0%, #89209e 100%);
}

.indicator-info {
  flex: 1;
}

.indicator-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 4rpx;
}

.indicator-level {
  font-size: 24rpx;
  color: #4a90e2;
}

.indicator-score {
  font-size: 48rpx;
  font-weight: 700;
  color: #4a90e2;
}

.indicator-reason {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.indicator-factors {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.factor-item {
  display: flex;
  align-items: center;
}

.factor-name {
  width: 120rpx;
  font-size: 26rpx;
  color: #666666;
}

.factor-bar-track {
  flex: 1;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.factor-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #4a90e2 0%, #48b879 100%);
  border-radius: 4rpx;
  transition: width 0.8s ease;
}

.factor-score {
  width: 60rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #4a90e2;
  text-align: right;
}

.item-bullet-wrap {
  width: 40rpx;
  height: 40rpx;
  background: rgba(72, 184, 121, 0.15);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.item-bullet-wrap.risk {
  background: rgba(255, 77, 79, 0.15);
}

.risk-card {
  border-left: 6rpx solid #ff4d4f;
}

.suggestion-card {
  border-left: 6rpx solid #4a90e2;
}

.financial-section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.financial-summary {
  margin-bottom: 28rpx;
  padding: 20rpx;
  background: linear-gradient(135deg, rgba(255, 153, 0, 0.1) 0%, rgba(255, 193, 7, 0.1) 100%);
  border-radius: 16rpx;
}

.financial-summary .summary-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.metric-card {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  position: relative;
}

.metric-name {
  display: block;
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

.metric-value {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.metric-indicator {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.metric-indicator.good {
  background: #4CAF50;
}

.metric-indicator.medium {
  background: #FF9800;
}

.metric-indicator.bad {
  background: #F44336;
}

.financial-chart-section {
  margin-bottom: 28rpx;
}

.chart-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

.chart-container {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
}

.chart-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 200rpx;
  margin-bottom: 20rpx;
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 16%;
}

.bar-wrapper {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 160rpx;
  justify-content: flex-end;
  gap: 4rpx;
}

.bar {
  width: 100%;
  border-radius: 8rpx 8rpx 0 0;
  transition: height 0.8s ease;
}

.bar.revenue-bar {
  background: linear-gradient(180deg, #4a90e2 0%, #357abd 100%);
}

.bar.profit-bar {
  background: linear-gradient(180deg, #48b879 0%, #38a06a 100%);
}

.bar-label {
  font-size: 22rpx;
  color: #999999;
  margin-top: 12rpx;
}

.bar-value {
  font-size: 20rpx;
  color: #666666;
  margin-top: 4rpx;
}

.chart-legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
}

.legend-item {
  display: flex;
  align-items: center;
}

.legend-color {
  width: 24rpx;
  height: 16rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
}

.legend-color.revenue {
  background: #4a90e2;
}

.legend-color.profit {
  background: #48b879;
}

.financial-table {
  margin-top: 16rpx;
}

.table-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

.table-header {
  display: flex;
  background: #f8f9fa;
  border-radius: 12rpx 12rpx 0 0;
  padding: 20rpx 16rpx;
}

.th {
  flex: 1;
  font-size: 24rpx;
  font-weight: 600;
  color: #666666;
  text-align: center;
}

.table-body {
  background: #ffffff;
  border: 2rpx solid #f0f0f0;
  border-radius: 0 0 12rpx 12rpx;
}

.table-row {
  display: flex;
  padding: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.table-row:last-child {
  border-bottom: none;
}

.td {
  flex: 1;
  font-size: 24rpx;
  color: #333333;
  text-align: center;
}

.indicator-icon.bg-cyan {
  background: linear-gradient(135deg, #00bcd4 0%, #0097a7 100%);
}

.disclaimer {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: rgba(255, 153, 0, 0.1);
  border-radius: 12rpx;
  margin-top: 24rpx;
}

.disclaimer-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.disclaimer-text {
  font-size: 24rpx;
  color: #8B4513;
  line-height: 1.5;
}

/* ============ AI评估加载弹窗样式 ============ */
.loading-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}

.loading-modal.show {
  display: flex;
}

.loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.85);
  backdrop-filter: blur(10rpx);
}

.loading-content {
  position: relative;
  width: 100%;
  max-width: 560rpx;
  background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
  border-radius: 32rpx;
  padding: 0;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.5);
  animation: modalFadeIn 0.4s ease;
  overflow: hidden;
}

@keyframes modalFadeIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* 上半部分：AI图标和标题 */
.top-section {
  text-align: center;
  padding: 56rpx 40rpx 40rpx;
  background: linear-gradient(180deg, rgba(74, 144, 226, 0.1) 0%, transparent 100%);
}

.ai-icon-box {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-pulse-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(74, 144, 226, 0.3) 0%, transparent 70%);
  animation: pulseExpand 2s ease-out infinite;
}

@keyframes pulseExpand {
  0% {
    transform: scale(1);
    opacity: 0.8;
  }
  100% {
    transform: scale(2);
    opacity: 0;
  }
}

.ai-emoji {
  font-size: 56rpx;
  position: relative;
  z-index: 1;
}

.loading-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.loading-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 下半部分：状态、进度、步骤 */
.bottom-section {
  padding: 40rpx;
}

/* 状态区域 */
.status-section {
  text-align: center;
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.status-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.typing-indicator {
  display: flex;
  gap: 6rpx;
}

.typing-dot {
  width: 8rpx;
  height: 8rpx;
  background: #4a90e2;
  border-radius: 50%;
  animation: typingBounce 1.4s ease-in-out infinite;
}

.typing-dot:nth-child(1) { animation-delay: 0s; }
.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingBounce {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.4;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* 进度条区域 */
.progress-section {
  margin-bottom: 36rpx;
}

.progress-bar {
  position: relative;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4rpx;
  overflow: visible;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4a90e2 0%, #50c878 100%);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.progress-glow {
  position: absolute;
  top: 50%;
  width: 16rpx;
  height: 16rpx;
  transform: translate(-50%, -50%);
  background: #ffffff;
  border-radius: 50%;
  box-shadow: 0 0 12rpx rgba(74, 144, 226, 0.8);
  transition: left 0.3s ease;
}

.progress-text {
  display: block;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #4a90e2;
  margin-top: 12rpx;
}

/* 步骤区域 */
.steps-section {
  display: flex;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.step-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  transition: all 0.3s ease;
}

.step-item.active .step-dot {
  background: #4a90e2;
  box-shadow: 0 0 10rpx rgba(74, 144, 226, 0.6);
  transform: scale(1.3);
}

.step-item.done .step-dot {
  background: #50c878;
  box-shadow: 0 0 8rpx rgba(80, 200, 120, 0.5);
}

.step-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
  transition: color 0.3s ease;
}

.step-item.active .step-text,
.step-item.done .step-text {
  color: rgba(255, 255, 255, 0.85);
}

/* 底部提示 */
.loading-footer {
  text-align: center;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.footer-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.4);
}