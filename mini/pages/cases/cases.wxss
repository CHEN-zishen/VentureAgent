.filter-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #ffffff;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.category-scroll {
  flex: 1;
  white-space: nowrap;
  margin-right: 24rpx;
}

.category-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  color: #666666;
  margin-right: 16rpx;
  border-radius: 40rpx;
  background: #f5f5f5;
  transition: all 0.3s;
}

.category-item.active {
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  color: #ffffff;
}

.filter-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
}

.filter-text {
  font-size: 26rpx;
  color: #666666;
}

.cases-content {
  padding: 24rpx;
}

.cases-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.case-item {
  width: calc(50% - 12rpx);
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.case-item.left {
  margin-right: 6rpx;
}

.case-item.right {
  margin-left: 6rpx;
}

.case-cover {
  position: relative;
  height: 200rpx;
  overflow: hidden;
}

.case-image {
  width: 100%;
  height: 100%;
}

.case-difficulty {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.4);
}

.case-difficulty.easy {
  background: rgba(72, 184, 121, 0.9);
}

.case-difficulty.medium {
  background: rgba(255, 153, 0, 0.9);
}

.case-difficulty.hard {
  background: rgba(255, 77, 79, 0.9);
}

.case-emoji-overlay {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  font-size: 48rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.case-body {
  padding: 24rpx;
}

.case-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.4;
}

.case-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.4;
}

.case-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.case-tags .tag {
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  margin: 0 6rpx 6rpx 0;
}

.case-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.case-meta {
  display: flex;
  align-items: center;
}

.meta-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.meta-text {
  font-size: 22rpx;
  color: #999999;
}

.case-rating {
  display: flex;
  align-items: center;
}

.rating-star {
  font-size: 22rpx;
  margin-right: 4rpx;
}

.rating-value {
  font-size: 24rpx;
  color: #ff9900;
  font-weight: 500;
}

.load-more {
  text-align: center;
  padding: 32rpx;
}

.load-more text {
  display: inline-block;
  padding: 16rpx 48rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666666;
}

.fab {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, 0.4);
}

.fab text {
  font-size: 40rpx;
  color: #ffffff;
}

.no-results {
  text-align: center;
  padding: 100rpx 0;
}

.no-results-icon {
  display: block;
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.no-results-text {
  font-size: 28rpx;
  color: #999999;
}

.filter-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: none;
}

.filter-modal.show {
  display: block;
}

.filter-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.filter-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  max-height: 70vh;
  overflow-y: auto;
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.filter-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.filter-close {
  font-size: 48rpx;
  color: #999999;
  padding: 0 16rpx;
}

.filter-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 20rpx;
}

.sort-options {
  display: flex;
  flex-wrap: wrap;
}

.sort-item {
  padding: 16rpx 32rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666666;
  margin: 0 16rpx 16rpx 0;
}

.sort-item.active {
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  color: #ffffff;
}

.difficulty-options {
  display: flex;
}

.difficulty-item {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666666;
  margin-right: 16rpx;
}

.difficulty-item.active {
  background: rgba(74, 144, 226, 0.1);
  border: 2rpx solid #4a90e2;
  color: #4a90e2;
}

.difficulty-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.difficulty-dot.easy {
  background: #48b87a;
}

.difficulty-dot.medium {
  background: #ff9900;
}

.difficulty-dot.hard {
  background: #ff4d4f;
}

.filter-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 32rpx;
}

.reset-btn {
  flex: 1;
  padding: 28rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  font-size: 30rpx;
  color: #666666;
  text-align: center;
  margin-right: 16rpx;
}

.apply-btn {
  flex: 2;
  padding: 28rpx;
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  border-radius: 40rpx;
  font-size: 30rpx;
  color: #ffffff;
  text-align: center;
}