<view class="container">
  <view class="filter-bar">
    <scroll-view class="category-scroll" scroll-x="true">
      <view class="category-item {{currentCategory === 'all' ? 'active' : ''}}" bindtap="selectCategory" data-category="all">
        全部
      </view>
      <view class="category-item {{currentCategory === item.id ? 'active' : ''}}"
            wx:for="{{categories}}"
            wx:key="id"
            bindtap="selectCategory"
            data-category="{{item.id}}">
        {{item.name}}
      </view>
    </scroll-view>
    <view class="filter-btn" bindtap="showFilter">
      <text class="filter-text">筛选</text>
    </view>
  </view>

  <view class="cases-content">
    <view class="cases-grid">
      <view class="case-item {{index % 2 === 0 ? 'left' : 'right'}}"
            wx:for="{{filteredCases}}"
            wx:key="id"
            bindtap="goToCaseDetail"
            data-id="{{item.id}}">
        <view class="case-cover">
          <image class="case-image" src="{{item.coverImage}}" mode="aspectFill"></image>
          <view class="case-difficulty {{item.difficulty}}">{{item.difficultyText}}</view>
          <text class="case-emoji-overlay">{{item.emoji}}</text>
        </view>
        <view class="case-body">
          <text class="case-title">{{item.title}}</text>
          <text class="case-desc">{{item.description}}</text>
          <view class="case-tags">
            <text class="tag tag-blue" wx:for="{{item.tags}}" wx:key="index" wx:for-item="tag">{{tag}}</text>
          </view>
          <view class="case-footer">
            <view class="case-meta">
              <text class="meta-icon">👥</text>
              <text class="meta-text">{{item.participants}}人学习</text>
            </view>
            <view class="case-rating">
              <text class="rating-star">⭐</text>
              <text class="rating-value">{{item.rating}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="load-more" wx:if="{{hasMore}}">
      <text bindtap="loadMore">加载更多案例</text>
    </view>

    <view class="no-results" wx:if="{{filteredCases.length === 0}}">
      <text class="no-results-icon">📭</text>
      <text class="no-results-text">暂无符合条件的案例</text>
    </view>
  </view>

  <view class="fab" bindtap="scrollToTop">
    <text>↑</text>
  </view>

  <view class="filter-modal {{showFilterModal ? 'show' : ''}}" wx:if="{{showFilterModal}}">
    <view class="filter-overlay" bindtap="hideFilter"></view>
    <view class="filter-content">
      <view class="filter-header">
        <text class="filter-title">筛选与排序</text>
        <text class="filter-close" bindtap="hideFilter">×</text>
      </view>

      <view class="filter-section">
        <view class="section-title">排序方式</view>
        <view class="sort-options">
          <view class="sort-item {{sortBy === item.id ? 'active' : ''}}"
                wx:for="{{sortOptions}}"
                wx:key="id"
                bindtap="selectSort"
                data-sort="{{item.id}}">
            {{item.name}}
          </view>
        </view>
      </view>

      <view class="filter-section">
        <view class="section-title">难度筛选</view>
        <view class="difficulty-options">
          <view class="difficulty-item {{filterOptions.difficulty.includes('easy') ? 'active' : ''}}"
                bindtap="toggleDifficulty"
                data-difficulty="easy">
            <text class="difficulty-dot easy"></text>
            简单
          </view>
          <view class="difficulty-item {{filterOptions.difficulty.includes('medium') ? 'active' : ''}}"
                bindtap="toggleDifficulty"
                data-difficulty="medium">
            <text class="difficulty-dot medium"></text>
            中等
          </view>
          <view class="difficulty-item {{filterOptions.difficulty.includes('hard') ? 'active' : ''}}"
                bindtap="toggleDifficulty"
                data-difficulty="hard">
            <text class="difficulty-dot hard"></text>
            困难
          </view>
        </view>
      </view>

      <view class="filter-actions">
        <view class="reset-btn" bindtap="resetFilter">重置</view>
        <view class="apply-btn" bindtap="applyFilter">应用筛选</view>
      </view>
    </view>
  </view>
</view>