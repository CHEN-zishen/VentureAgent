.knowledge-header {
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #1a1a2e 0%, #2d2d4a 100%);
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.knowledge-tabs {
  display: flex;
  padding: 24rpx 32rpx;
  background: #ffffff;
}

.tab-item {
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  color: #666666;
  margin-right: 24rpx;
  border-radius: 40rpx;
  background: #f5f5f5;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  color: #ffffff;
}

.knowledge-content {
  padding: 24rpx 32rpx;
  height: calc(100vh - 380rpx);
}

.category-section {
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
}

.category-info {
  display: flex;
  align-items: center;
}

.category-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.category-text {
  display: flex;
  flex-direction: column;
}

.category-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 4rpx;
}

.category-count {
  font-size: 24rpx;
  color: #999999;
}

.toggle-icon {
  font-size: 24rpx;
  color: #999999;
  transition: transform 0.3s;
}

.toggle-icon.expanded {
  transform: rotate(180deg);
}

.knowledge-list {
  padding: 0 24rpx 24rpx;
}

.knowledge-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.knowledge-icon-small {
  width: 48rpx;
  height: 48rpx;
  background: #4a90e2;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 600;
}

.knowledge-info {
  flex: 1;
}

.knowledge-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 4rpx;
}

.knowledge-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

.knowledge-progress {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

.progress-bar {
  width: 80rpx;
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
  margin-right: 8rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 4rpx;
}

.progress-text {
  font-size: 20rpx;
  color: #999999;
}

.learning-path {
  margin-top: 32rpx;
}

.path-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 24rpx;
}

.path-steps {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.path-step {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.path-step:last-child {
  margin-bottom: 0;
}

.step-number {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  margin-right: 20rpx;
}

.step-content {
  flex: 1;
}

.step-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 4rpx;
}

.step-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

.step-arrow {
  font-size: 32rpx;
  color: #cccccc;
  margin-left: 16rpx;
}