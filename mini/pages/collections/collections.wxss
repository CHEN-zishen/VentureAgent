.collections-list {
  padding: 24rpx 32rpx;
  height: calc(100vh - 100rpx);
}

.collection-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-cover {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.card-emoji {
  font-size: 48rpx;
}

.card-info {
  flex: 1;
}

.card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.card-category {
  display: block;
  font-size: 24rpx;
  color: #4a90e2;
  margin-bottom: 8rpx;
}

.card-meta {
  display: flex;
}

.meta-item {
  font-size: 22rpx;
  color: #999999;
  margin-right: 16rpx;
}

.card-action {
  padding: 12rpx;
}

.empty-state {
  text-align: center;
  padding: 150rpx 0;
}

.empty-icon {
  display: block;
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}

.empty-tip {
  display: block;
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 32rpx;
}

.empty-btn {
  display: inline-block;
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #ffffff;
}