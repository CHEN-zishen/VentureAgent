.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

.header {
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.filter-bar {
  display: flex;
  padding: 20rpx 24rpx;
  gap: 16rpx;
  overflow-x: auto;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.filter-item {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 32rpx;
  transition: all 0.3s;
}

.filter-item.active {
  color: #fff;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 20rpx 60rpx;
  font-size: 28rpx;
  color: #fff;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 40rpx;
}

.record-list {
  height: calc(100vh - 320rpx);
  padding: 24rpx;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.record-left {
  margin-right: 24rpx;
}

.record-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
}

.record-icon text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.record-center {
  flex: 1;
}

.record-type {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.record-info {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-time {
  font-size: 22rpx;
  color: #999;
}

.record-right {
  text-align: right;
}

.record-score {
  margin-bottom: 8rpx;
}

.score-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.score-unit {
  font-size: 20rpx;
  color: #999;
}

.record-arrow {
  font-size: 28rpx;
  color: #ccc;
}

.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content {
  width: 100%;
  max-height: 85vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999;
}

.modal-body {
  max-height: 65vh;
  padding: 32rpx;
}

.result-summary {
  margin-bottom: 32rpx;
}

.result-score {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  border-radius: 24rpx;
}

.result-num {
  font-size: 80rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.result-grade {
  font-size: 36rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 8rpx;
}

.result-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.dimension-section {
  margin-bottom: 32rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.dimension-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.dimension-card {
  width: calc(50% - 8rpx);
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  text-align: center;
}

.dimension-icon {
  font-size: 36rpx;
  margin-bottom: 12rpx;
}

.dimension-name {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.dimension-score {
  font-size: 32rpx;
  font-weight: 600;
}

.section {
  margin-bottom: 32rpx;
}

.list-group {
  padding-left: 8rpx;
}

.list-item {
  display: flex;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}

.list-dot {
  margin-right: 16rpx;
  color: #667eea;
}

.info-row {
  display: flex;
  padding: 16rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-label {
  color: #999;
  width: 180rpx;
}

.info-value {
  color: #333;
  flex: 1;
}

.modal-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx 40rpx;
  border-top: 1rpx solid #eee;
}

.footer-btn {
  flex: 1;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.footer-btn.secondary {
  color: #666;
  background: #f5f5f5;
}

.footer-btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}