page {
  background: #f5f5f5;
  min-height: 100vh;
}

.container {
  padding-bottom: 120rpx;
}

.trend-header {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  padding: 40rpx 32rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.trend-top {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.trend-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 16rpx;
}

.trend-meta {
  flex: 1;
}

.trend-industry {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 4rpx;
}

.trend-time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

.trend-tag {
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
}

.trend-tag text {
  font-size: 22rpx;
  font-weight: 500;
}

.trend-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.trend-score {
  display: flex;
  align-items: center;
}

.score-circle {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.score-value {
  font-size: 24rpx;
}

.score-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.trend-content {
  padding: 32rpx;
  margin-top: -20rpx;
}

.section {
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 16rpx;
}

.content-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.content-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.8;
}

.data-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.data-main {
  display: flex;
  flex-direction: column;
}

.data-value {
  font-size: 48rpx;
  font-weight: 600;
  color: #4a90e2;
}

.data-label {
  font-size: 24rpx;
  color: #999999;
}

.data-change {
  display: flex;
  align-items: center;
  background: rgba(76, 175, 80, 0.1);
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
}

.change-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.change-value {
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 8rpx;
}

.change-label {
  font-size: 24rpx;
}

.reason-list {
  padding: 0;
}

.reason-item {
  display: flex;
  margin-bottom: 20rpx;
}

.reason-item:last-child {
  margin-bottom: 0;
}

.reason-number {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #ff9900 0%, #e68a00 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.reason-content {
  flex: 1;
}

.reason-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.reason-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.prospect-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.prospect-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.prospect-item:last-child {
  border-bottom: none;
}

.prospect-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.prospect-info {
  flex: 1;
}

.prospect-value {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 4rpx;
}

.prospect-label {
  font-size: 24rpx;
  color: #999999;
}

.company-list {
  padding: 0;
}

.company-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.company-card:last-child {
  margin-bottom: 0;
}

.company-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 16rpx;
}

.company-info {
  flex: 1;
}

.company-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 4rpx;
}

.company-desc {
  font-size: 24rpx;
  color: #999999;
}

.company-status {
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

.company-status.leader {
  background: #e8f5e9;
  color: #4caf50;
}

.company-status.growing {
  background: #e3f2fd;
  color: #2196f3;
}

.company-status.potential {
  background: #fff3e0;
  color: #ff9800;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.trend-image {
  width: 100%;
  height: 200rpx;
  border-radius: 16rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  background: linear-gradient(135deg, #48b879 0%, #3d9d6b 100%);
  color: #ffffff;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
}

.source-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.source-info {
  display: flex;
  align-items: center;
}

.source-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.source-text {
  font-size: 28rpx;
  color: #4a90e2;
}

.source-arrow {
  font-size: 32rpx;
  color: #cccccc;
}

.bottom-space {
  height: 40rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  display: flex;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.bar-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  border-radius: 16rpx;
}

.bar-btn.primary {
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
}

.bar-btn.primary .bar-text {
  color: #ffffff;
}

.bar-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.bar-text {
  font-size: 24rpx;
  color: #666666;
}