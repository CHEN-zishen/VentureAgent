.search-header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #1a1a2e;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50rpx;
  padding: 16rpx 24rpx;
  margin-right: 24rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  opacity: 0.7;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #ffffff;
}

.clear-btn {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.6);
  padding: 0 8rpx;
}

.cancel-btn {
  font-size: 28rpx;
  color: #ffffff;
}

.search-content {
  padding: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 24rpx;
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
}

.hot-tag {
  padding: 16rpx 28rpx;
  background: linear-gradient(135deg, rgba(74, 144, 226, 0.1) 0%, rgba(53, 122, 189, 0.1) 100%);
  border: 1rpx solid rgba(74, 144, 226, 0.3);
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #4a90e2;
  margin: 0 16rpx 16rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.clear-history {
  font-size: 26rpx;
  color: #ff4d4f;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
}

.history-item {
  padding: 16rpx 28rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666666;
  margin: 0 16rpx 16rpx 0;
}

.results-count {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 32rpx;
}

.result-section {
  margin-bottom: 40rpx;
}

.result-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 20rpx;
}

.result-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.result-item-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}

.result-item-desc {
  display: block;
  font-size: 26rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.no-results {
  text-align: center;
  padding: 80rpx 0;
}

.no-results-icon {
  display: block;
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.no-results-text {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.no-results-tip {
  display: block;
  font-size: 26rpx;
  color: #999999;
}