.header-section {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  padding: 40rpx 32rpx 60rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.greeting {
  margin-bottom: 32rpx;
}

.greeting-text {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.greeting-sub {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.search-box {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50rpx;
  padding: 24rpx 32rpx;
  backdrop-filter: blur(10px);
}

.search-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  opacity: 0.7;
}

.search-placeholder {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.quick-actions {
  display: flex;
  justify-content: space-between;
  padding: 0 24rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 10;
}

.action-card {
  flex: 1;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 16rpx;
  text-align: center;
  margin: 0 12rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.action-icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 16rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  position: relative;
  padding-bottom: 4rpx;
}

.action-emoji {
  font-size: 52rpx;
  line-height: 1;
}

.ai-icon {
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  position: relative;
  left: -34rpx;
}

.ai-icon .action-emoji {
  font-size: 48rpx;
}

.case-icon {
  background: linear-gradient(135deg, #48b879 0%, #3d9d6b 100%);
}

.trend-icon {
  background: linear-gradient(135deg, #ff9900 0%, #e68a00 100%);
}

.action-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.action-desc {
  display: block;
  font-size: 22rpx;
  color: #999999;
}

.section {
  padding: 32rpx 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.section-sub {
  font-size: 24rpx;
  color: #999999;
  margin-left: 16rpx;
}

.section-more {
  font-size: 26rpx;
  color: #4a90e2;
}

.section-tip {
  font-size: 24rpx;
  color: #999999;
}

.case-scroll {
  white-space: nowrap;
}

.case-card {
  display: inline-block;
  width: 280rpx;
  margin-right: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  vertical-align: top;
}

.case-cover {
  position: relative;
  width: 100%;
  height: 200rpx;
}

.case-cover-image {
  width: 100%;
  height: 100%;
}

.case-cover-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.case-emoji {
  font-size: 48rpx;
}

.case-info {
  padding: 20rpx;
}

.case-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 12rpx;
  white-space: normal;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.case-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.case-category {
  font-size: 22rpx;
  color: #999999;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.case-rating {
  font-size: 22rpx;
  color: #ff9900;
}

.ai-evaluate-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ai-content {
  flex: 1;
}

.ai-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.ai-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.ai-main-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.ai-badge {
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  margin-left: 12rpx;
}

.ai-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 24rpx;
}

.ai-features-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.ai-feature-item {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 16rpx;
}

.ai-feature-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  font-size: 28rpx;
}

.bg-blue {
  background: rgba(74, 144, 226, 0.8);
}

.bg-green {
  background: rgba(72, 184, 121, 0.8);
}

.bg-orange {
  background: rgba(255, 153, 0, 0.8);
}

.bg-purple {
  background: rgba(156, 39, 176, 0.8);
}

.ai-feature-title {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #ffffff;
  margin-bottom: 4rpx;
}

.ai-feature-desc {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
}

.ai-arrow {
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.6);
}

.sphere-container {
  position: relative;
  width: 100%;
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sphere-bg-layer {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
}

.sphere-wrapper {
  position: relative;
  width: 320rpx;
  height: 320rpx;
}

.sphere-bg {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 300rpx;
  height: 300rpx;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  border-radius: 50%;
  box-shadow: 0 0 60rpx rgba(74, 144, 226, 0.3);
}

.sphere-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  border: 2rpx solid rgba(74, 144, 226, 0.3);
  border-radius: 50%;
}

.ring-1 {
  width: 340rpx;
  height: 340rpx;
}

.ring-2 {
  width: 380rpx;
  height: 380rpx;
  transform: translate(-50%, -50%) rotateX(60deg);
}

.knowledge-node {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: opacity 0.3s, transform 0.3s;
}

.node-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.node-name {
  font-size: 20rpx;
  color: #666666;
  margin-top: 8rpx;
  white-space: nowrap;
}

.knowledge-hint {
  text-align: center;
  margin-top: 24rpx;
}

.knowledge-hint text {
  font-size: 24rpx;
  color: #999999;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
}

.stat-divider {
  width: 2rpx;
  background: #f0f0f0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #999999;
}

.empty-btn {
  margin-top: 32rpx;
  background: #4a90e2;
  color: #ffffff;
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}