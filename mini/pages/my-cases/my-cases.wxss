.learning-stats {
  display: flex;
  justify-content: space-around;
  padding: 32rpx;
  background: linear-gradient(135deg, #1a1a2e 0%, #2d2d4a 100%);
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.stat-divider {
  width: 1rpx;
  background: rgba(255, 255, 255, 0.2);
}

.learning-tabs {
  display: flex;
  padding: 24rpx 32rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666666;
  position: relative;
}

.tab-item.active {
  color: #4a90e2;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #4a90e2;
  border-radius: 3rpx;
}

.learning-list {
  padding: 24rpx 32rpx;
  height: calc(100vh - 350rpx);
}

.learning-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-cover {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.card-emoji {
  font-size: 48rpx;
}

.card-info {
  flex: 1;
}

.card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}

.card-progress {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.progress-bar {
  flex: 1;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  margin-right: 12rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 4rpx;
}

.progress-text {
  font-size: 22rpx;
  color: #999999;
  min-width: 60rpx;
}

.card-time {
  font-size: 22rpx;
  color: #999999;
}

.card-action {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  border-radius: 40rpx;
  font-size: 24rpx;
  color: #ffffff;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  display: block;
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}

.empty-tip {
  display: block;
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 32rpx;
}

.empty-btn {
  display: inline-block;
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #ffffff;
}