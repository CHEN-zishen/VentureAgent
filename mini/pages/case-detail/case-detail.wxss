page {
  background: #f5f5f5;
  min-height: 100vh;
}

.container {
  padding-bottom: 120rpx;
}

.case-header {
  position: relative;
  height: 400rpx;
}

.case-banner {
  width: 100%;
  height: 100%;
}

.case-header-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
}

.case-emoji-large {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.case-category-badge {
  display: inline-block;
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(10px);
}

.case-content {
  padding: 32rpx;
  margin-top: -40rpx;
}

.case-title-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.case-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a2e;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.case-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.case-rating {
  font-size: 28rpx;
  color: #ff9900;
}

.case-difficulty {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.case-difficulty.easy {
  background: #e8f5e9;
  color: #4caf50;
}

.case-difficulty.medium {
  background: #fff3e0;
  color: #ff9800;
}

.case-difficulty.hard {
  background: #ffebee;
  color: #f44336;
}

.section {
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 16rpx;
}

.content-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.content-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.8;
}

.problem-list {
  padding: 0;
}

.problem-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.problem-item:last-child {
  margin-bottom: 0;
}

.problem-number {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.problem-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  flex: 1;
}

.solution-list {
  padding: 0;
}

.solution-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.solution-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.solution-icon {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #48b879 0%, #3d9d6b 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.solution-content {
  flex: 1;
}

.solution-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.solution-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.stat-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #4a90e2;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.case-image {
  width: 100%;
  height: 200rpx;
  border-radius: 16rpx;
}

.knowledge-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.knowledge-tag {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
}

.source-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.source-info {
  display: flex;
  align-items: center;
}

.source-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.source-text {
  font-size: 28rpx;
  color: #4a90e2;
}

.source-arrow {
  font-size: 32rpx;
  color: #cccccc;
}

.bottom-space {
  height: 40rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  display: flex;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.bar-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  border-radius: 16rpx;
}

.bar-btn.primary {
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
}

.bar-btn.primary .bar-text {
  color: #ffffff;
}

.bar-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.bar-text {
  font-size: 24rpx;
  color: #666666;
}