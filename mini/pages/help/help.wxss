.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.help-tabs {
  display: flex;
  background-color: #fff;
  border-bottom: 1px solid #eee;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #4a90e2;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #4a90e2;
  border-radius: 2rpx;
}

.help-content {
  height: calc(100vh - 100rpx);
  padding: 20rpx;
}

.faq-list {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.faq-item {
  border-bottom: 1px solid #f0f0f0;
  padding: 24rpx 0;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.question-text {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.question-icon {
  font-size: 20rpx;
  color: #999;
  transition: transform 0.3s;
}

.question-icon.expanded {
  transform: rotate(180deg);
}

.faq-answer {
  margin-top: 20rpx;
  padding-left: 20rpx;
}

.answer-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

.contact-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.contact-title {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.contact-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.contact-label {
  font-size: 26rpx;
  color: #666;
}

.feedback-form {
  padding: 20rpx;
}

.form-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
  display: block;
}

.type-selector {
  display: flex;
  gap: 20rpx;
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
  background-color: #f5f5f5;
}

.type-item.active {
  background-color: #e8f4fc;
  color: #4a90e2;
}

.feedback-input {
  width: 100%;
  height: 200rpx;
  border: 1px solid #eee;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}

.contact-input {
  width: 100%;
  height: 80rpx;
  border: 1px solid #eee;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #4a90e2, #357abd);
  color: #fff;
  text-align: center;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
  margin-top: 40rpx;
}