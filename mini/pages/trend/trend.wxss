.trend-header {
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #1a1a2e 0%, #2d2d4a 100%);
}

.trend-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.trend-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.category-tabs {
  display: flex;
  padding: 24rpx 32rpx;
  background: #ffffff;
  overflow-x: auto;
  white-space: nowrap;
}

.tab-item {
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  color: #666666;
  margin-right: 24rpx;
  border-radius: 40rpx;
  background: #f5f5f5;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  color: #ffffff;
}

.trend-list {
  padding: 24rpx 32rpx;
  height: calc(100vh - 400rpx);
}

.trend-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.trend-card.hot {
  border-left: 6rpx solid #ff4d4f;
}

.trend-card.up {
  border-left: 6rpx solid #48b879;
}

.trend-card.stable {
  border-left: 6rpx solid #999999;
}

.trend-header-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.trend-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.trend-info {
  flex: 1;
}

.trend-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.trend-meta {
  display: flex;
  align-items: center;
}

.trend-industry {
  font-size: 24rpx;
  color: #4a90e2;
  margin-right: 16rpx;
}

.trend-time {
  font-size: 24rpx;
  color: #999999;
}

.trend-badge {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.trend-badge.hot {
  background: rgba(255, 77, 79, 0.1);
  color: #ff4d4f;
}

.trend-badge.up {
  background: rgba(72, 184, 121, 0.1);
  color: #48b879;
}

.trend-badge.stable {
  background: rgba(153, 153, 153, 0.1);
  color: #999999;
}

.trend-desc {
  display: block;
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.trend-data {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.data-item {
  text-align: center;
  flex: 1;
}

.data-value {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 6rpx;
}

.data-value.up {
  color: #48b879;
}

.data-value.down {
  color: #ff4d4f;
}

.data-label {
  font-size: 22rpx;
  color: #999999;
}

.trend-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.trend-tag {
  padding: 8rpx 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #666666;
  margin: 0 8rpx 8rpx 0;
}

.trend-actions {
  display: flex;
  justify-content: space-between;
}

.action-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #f8f8f8;
  border-radius: 40rpx;
}

.action-btn text {
  font-size: 24rpx;
  color: #666666;
  margin-left: 6rpx;
}

.load-more {
  text-align: center;
  padding: 32rpx;
}

.load-more text {
  display: inline-block;
  padding: 16rpx 48rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666666;
}