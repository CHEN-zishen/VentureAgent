<view class="container">
  <view class="trend-header">
    <view class="trend-title">📊 商业趋势洞察</view>
    <text class="trend-subtitle">洞察市场动态，把握商业先机</text>
  </view>

  <view class="category-tabs">
    <view class="tab-item {{currentTab === index ? 'active' : ''}}" 
          wx:for="{{categories}}" 
          wx:key="index"
          bindtap="switchTab" 
          data-index="{{index}}">
      {{item.name}}
    </view>
  </view>

  <scroll-view class="trend-list" scroll-y="true">
    <view class="trend-card {{item.trend}}" wx:for="{{trends}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="trend-header-row">
        <view class="trend-icon" style="background: {{item.color}}20;">
          <text style="font-size: 48rpx;">{{item.icon}}</text>
        </view>
        <view class="trend-info">
          <text class="trend-name">{{item.title}}</text>
          <view class="trend-meta">
            <text class="trend-industry">{{item.industry}}</text>
            <text class="trend-time">{{item.time}}</text>
          </view>
        </view>
        <view class="trend-badge {{item.trend}}">
          {{item.trendText}}
        </view>
      </view>
      
      <text class="trend-desc">{{item.summary}}</text>
      
      <view class="trend-data">
        <view class="data-item">
          <text class="data-value">{{item.data.value}}</text>
          <text class="data-label">{{item.data.label}}</text>
        </view>
        <view class="data-item">
          <text class="data-value {{item.change > 0 ? 'up' : 'down'}}">{{item.change > 0 ? '+' : ''}}{{item.change}}%</text>
          <text class="data-label">同比变化</text>
        </view>
        <view class="data-item">
          <text class="data-value">{{item.investors}}</text>
          <text class="data-label">投资热度</text>
        </view>
      </view>

      <view class="trend-tags">
        <text class="trend-tag" wx:for="{{item.tags}}" wx:key="index">{{item}}</text>
      </view>

      <view class="trend-actions">
        <view class="action-btn" bindtap="toggleCollect" data-id="{{item.id}}">
          <text>{{item.collected ? '❤️' : '🤍'}}</text>
          <text>{{item.collected ? '已收藏' : '收藏'}}</text>
        </view>
        <view class="action-btn" bindtap="shareTrend" data-id="{{item.id}}">
          <text>📤</text>
          <text>分享</text>
        </view>
        <view class="action-btn" bindtap="readMore" data-id="{{item.id}}">
          <text>📖</text>
          <text>阅读全文</text>
        </view>
      </view>
    </view>

    <view class="load-more" wx:if="{{hasMore}}">
      <text bindtap="loadMore">加载更多趋势</text>
    </view>
  </scroll-view>
</view>