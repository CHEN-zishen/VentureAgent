.settings-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 26rpx;
  color: #999999;
  padding: 16rpx 32rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-item:last-child {
  border-bottom: none;
}

.item-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.item-label {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}

.item-value {
  font-size: 26rpx;
  color: #999999;
  margin-right: 12rpx;
}

.item-arrow {
  font-size: 28rpx;
  color: #cccccc;
}

.item-switch {
  transform: scale(0.8);
}

.logout-btn {
  margin: 48rpx 32rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 16rpx;
  text-align: center;
  font-size: 30rpx;
  color: #ff4d4f;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}