page {
  background-color: #f8f8f8;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.btn-primary {
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  color: #ffffff;
  border-radius: 50rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, 0.3);
}

.btn-secondary {
  background: #ffffff;
  color: #4a90e2;
  border-radius: 50rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: 2rpx solid #4a90e2;
}

.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin: 8rpx;
}

.tag-blue {
  background: rgba(74, 144, 226, 0.15);
  color: #4a90e2;
}

.tag-green {
  background: rgba(72, 184, 121, 0.15);
  color: #48b879;
}

.tag-orange {
  background: rgba(255, 153, 0, 0.15);
  color: #ff9900;
}

.tag-red {
  background: rgba(255, 77, 79, 0.15);
  color: #ff4d4f;
}